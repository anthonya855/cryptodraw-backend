# ---------- Server ----------
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cryptodraw
PUBLIC_ORIGINS=https://your-store.myshopify.com,https://yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
ADMIN_SESSION_HOURS=12

# ---------- Payment networks ----------
# Add only the networks you actually accept. The backend never assumes a token contract.
# amountDecimals MUST match the USDT contract on that chain.
EVM_NETWORKS_JSON=[{"key":"bsc","name":"BNB Smart Chain","chainId":56,"rpcUrl":"https://YOUR-RPC","usdtContract":"0xYOUR_VERIFIED_USDT_CONTRACT","receiverAddress":"0xYOUR_RECEIVER_WALLET","amountDecimals":18,"confirmations":3}]

# TronGrid apiBase can be mainnet or a test network. apiKey is optional but recommended for production.
TRON_NETWORKS_JSON=[{"key":"tron","name":"TRON","apiBase":"https://api.trongrid.io","apiKey":"YOUR_TRONGRID_API_KEY","usdtContract":"T_YOUR_VERIFIED_USDT_CONTRACT","receiverAddress":"T_YOUR_RECEIVER_WALLET","amountDecimals":6,"feeLimitSun":100000000}]

# ---------- drand ----------
# Pin the official chain identity. Get /info from the official drand endpoint and copy the hash + public_key.
DRAND_BASE_URL=https://api.drand.sh
DRAND_CHAIN_HASH=PASTE_OFFICIAL_CHAIN_HASH
DRAND_PUBLIC_KEY=PASTE_OFFICIAL_PUBLIC_KEY

# Optional: create a starter pool during migration when none exists.
SEED_POOL_ID=POOL-2026-0142
SEED_POOL_PRIZE=0.42 BTC
SEED_POOL_PRIZE_USD=$27,300
SEED_POOL_ENTRY_FEE_USDT=1.000000
SEED_POOL_MAX_ENTRIES=25000
SEED_POOL_CLOSES_AT=2026-08-31T18:00:00Z
